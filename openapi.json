{
  "openapi": "3.0.3",
  "info": {
    "title": "IPFS Hyperledger Fabric Verification Backend API",
    "description": "API dokumentasi untuk sistem verifikasi ijazah terdesentralisasi menggunakan Hyperledger Fabric, IPFS, PostgreSQL, dan autentikasi issuer admin berbasis JWT.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["identifier", "password"],
        "properties": {
          "identifier": { "type": "string", "example": "admin" },
          "password": { "type": "string", "example": "admin123" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "object",
            "properties": {
              "accessToken": { "type": "string", "example": "<jwt>" },
              "tokenType": { "type": "string", "example": "Bearer" },
              "issuer": {
                "type": "object",
                "properties": {
                  "issuerId": { "type": "string", "example": "UNDIP" },
                  "organizationName": { "type": "string", "example": "Universitas Diponegoro" },
                  "departmentName": { "type": "string", "example": "Fakultas Teknik" },
                  "mspId": { "type": "string", "example": "Org1MSP" },
                  "username": { "type": "string", "example": "admin" },
                  "email": { "type": "string", "example": "admin@undip.ac.id" }
                }
              }
            }
          }
        }
      },
      "IssueCertificateRequest": {
        "type": "object",
        "required": ["certificateNumber", "certificateType", "degreeTitle", "ipfsCid", "issuedAt"],
        "properties": {
          "certificateId": { "type": "string", "example": "UUID-1234" },
          "certificateNumber": { "type": "string", "example": "CERT-2026-TI-0001" },
          "studentId": { "type": "string", "example": "NIM-12345" },
          "studentIdHash": { "type": "string", "example": "a4d3..." },
          "issuerId": { "type": "string", "description": "Ignored for authenticated requests; server derives issuer from JWT.", "example": "UNDIP" },
          "certificateType": { "type": "string", "example": "DIPLOMA" },
          "degreeTitle": { "type": "string", "example": "Bachelor of Computer Science" },
          "ipfsCid": { "type": "string", "example": "bafybeigdyrzt..." },
          "issuedAt": { "type": "string", "example": "2026-06-27" },
          "expiredAt": { "type": "string", "example": "" }
        }
      },
      "UploadRequest": {
        "type": "object",
        "required": ["file_ijazah", "certificateNumber", "certificateType", "degreeTitle", "studentId", "studentName", "studyProgram", "educationLevel", "issuedAt"],
        "properties": {
          "file_ijazah": { "type": "string", "format": "binary" },
          "certificateId": { "type": "string", "example": "UUID-1234" },
          "certificateNumber": { "type": "string", "example": "CERT-2026-TI-0001" },
          "issuerId": { "type": "string", "description": "Ignored for authenticated requests; derived from authenticated issuer.", "example": "UNDIP" },
          "organizationName": { "type": "string", "description": "Ignored for authenticated requests; derived from authenticated issuer.", "example": "Universitas Diponegoro" },
          "departmentName": { "type": "string", "description": "Required certificate/faculty metadata. Not derived from authenticated issuer; client must send the issuing faculty/department.", "example": "Fakultas Teknik" },
          "mspId": { "type": "string", "description": "Ignored for authenticated requests; derived from authenticated issuer.", "example": "Org1MSP" },,
          "certificateType": { "type": "string", "example": "DIPLOMA" },
          "degreeTitle": { "type": "string", "example": "Bachelor of Computer Science" },
          "studentId": { "type": "string", "example": "NIM-12345" },
          "studentName": { "type": "string", "example": "John Doe" },
          "studyProgram": { "type": "string", "example": "Teknik Informatika" },
          "educationLevel": { "type": "string", "example": "S1" },
          "graduationDate": { "type": "string", "example": "2026-06-30" },
          "issuedAt": { "type": "string", "example": "2026-06-27" }
        }
      },
      "DatabaseCertificate": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "certificateId": { "type": "string", "example": "UUID-1234" },
          "certificateNumber": { "type": "string", "example": "CERT-2026-TI-0001" },
          "issuerId": { "type": "string", "example": "UNDIP" },
          "certificateType": { "type": "string", "example": "DIPLOMA" },
          "degreeTitle": { "type": "string", "example": "Bachelor of Computer Science" },
          "studentId": { "type": "string", "example": "NIM-12345" },
          "studentName": { "type": "string", "example": "John Doe" },
          "organizationName": { "type": "string", "example": "Universitas Diponegoro" },
          "studyProgram": { "type": "string", "example": "Teknik Informatika" },
          "educationLevel": { "type": "string", "example": "S1" },
          "graduationDate": { "type": "string", "nullable": true, "example": null },
          "ipfsCid": { "type": "string", "example": "bafybeigdyrzt..." },
          "file_name": { "type": "string", "example": "ijazah.pdf" },
          "mime_type": { "type": "string", "example": "application/pdf" },
          "file_size": { "type": "integer", "example": 1048576 },
          "ledger_tx_id": { "type": "string", "example": "tx-id-blockchain-abc" },
          "status": { "type": "string", "example": "VALID" },
          "issuedAt": { "type": "string", "example": "2026-06-27T00:00:00.000Z" },
          "created_at": { "type": "string", "example": "2026-06-27T00:00:00.000Z" },
          "updated_at": { "type": "string", "example": "2026-06-29T08:00:00.000Z" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "responses": {
          "200": {
            "description": "Server is running"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Issuer admin login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/verify/{certificateNumber}": {
      "get": {
        "summary": "Public certificate verification",
        "parameters": [
          {
            "name": "certificateNumber",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Verification result" }
        }
      }
    },
    "/verify/{certificateNumber}": {
      "get": {
        "summary": "Public certificate verification alias",
        "parameters": [
          {
            "name": "certificateNumber",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Verification result" }
        }
      }
    },
    "/api/": {
      "get": {
        "summary": "Public certificate search/list endpoint",
        "responses": {
          "200": {
            "description": "List of certificate metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/DatabaseCertificate" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/upload": {
      "post": {
        "summary": "Protected certificate upload",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/UploadRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Certificate uploaded successfully"
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/certificates": {
      "get": {
        "summary": "Protected ledger certificate list",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Ledger certificates" } }
      },
      "post": {
        "summary": "Protected direct issue certificate endpoint",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IssueCertificateRequest" }
            }
          }
        },
        "responses": { "201": { "description": "Certificate issued" } }
      }
    },
    "/api/certificates/{certificateId}/verify": {
      "post": {
        "summary": "Protected legacy manual verify endpoint",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Verification result" } }
      }
    },
    "/api/fabric/health": {
      "get": {
        "summary": "Protected Fabric health",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Fabric health" } }
      }
    },
    "/api/fabric/invoke": {
      "post": {
        "summary": "Protected Fabric invoke",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Invoke result" } }
      }
    }
  }
}
